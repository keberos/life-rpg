{
  "name": "life-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Life RPG: replace the doomscroll with short, calibrated real-life quests that power a fantasy character.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sprites": "node art-kit/cli/export-app.ts",
    "sim": "node sim/simulate.ts",
    "test": "vitest run",
    "tune": "node sim/tune.ts",
    "explain": "node sim/explain.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "preact": "^11.2.0"
  }
}
